[node name="LvlnSkills" type="Button" parent="HelpTabHolder/ScrollContainer/VBoxContainer" unique_id=1431265586]
layout_mode = 2
theme = ExtResource("3_k1sou")
text = "Levels and Skills"
script = ExtResource("5_oumk7")
Name = "Levels And Skills"
description = "For every level up you get 2 stat points and 1 skill point, you can use the stat points to increase either your mana or your damage while the skill points can be invested in the skill tree"

[node name="GldnMonster" type="Button" parent="HelpTabHolder/ScrollContainer/VBoxContainer" unique_id=569686895]
layout_mode = 2
theme = ExtResource("3_k1sou")
text = "Variant Monsters"
script = ExtResource("5_oumk7")
Name = "Variant Monsters"
description = "With the help of mana monsters mutate into stronger variants of themselves although not all monsters are capable of having variants and its insanely rare, visit each monsters specific page to see their variants"

[node name="Sin" type="Button" parent="HelpTabHolder/ScrollContainer/VBoxContainer" unique_id=825133829]
layout_mode = 2
theme = ExtResource("3_k1sou")
text = "Sin"
script = ExtResource("5_oumk7")
Name = "Prime Sins"
description = "The seven prime sins manifest themselves in compatible monsters granting them unimaginable strength although you would have to be extremely lucky (or unlucky)  to see even one manifestation in a hundred years, there are records of rituals being conducted by prime sins to summon other prime sins, they hold no allegiance to anyone"

[node name="Class" type="Button" parent="HelpTabHolder/ScrollContainer/VBoxContainer" unique_id=1543451122]
layout_mode = 2
theme = ExtResource("3_k1sou")
text = "Class"
script = ExtResource("5_oumk7")
Name = "Class"
description = "Classes are unique to humans (and some intelligent humanoids) and they are a way of specializing that increase an individual's strength greatly"

