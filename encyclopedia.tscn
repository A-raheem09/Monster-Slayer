[node name="Mucus" type="Button" parent="MonsterTabHolder/ScrollContainer/VBoxContainer" unique_id=288221463]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("3_k1sou")
text = "Mucus
"
script = ExtResource("4_lddes")
Name = "Mucus"
description = "Born from the combination of bacteria that feeds off of dead corpses into one single organism,Its slimey body is highly corrosive to human flesh "
variant_description = "Theres records of a special specimen of mucus that can regenerate from a single cell making it nigh immortal and it has the potential to become as strong as a [Dragon] given enough time, it is difficult to spot one of this specimen in a 1000 years"

[node name="MonstSpider" type="Button" parent="MonsterTabHolder/ScrollContainer/VBoxContainer" unique_id=477473838]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("3_k1sou")
text = "Monstrous Spider
"
script = ExtResource("4_lddes")
Name = "Monstrous Spider"
description = "A specific species of spider that has evolved to harness mana letting it grow larger than an average"
variant_description = "No special cases"

[node name="Goblin" type="Button" parent="MonsterTabHolder/ScrollContainer/VBoxContainer" unique_id=728592706]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("3_k1sou")
text = "Goblin"
script = ExtResource("4_lddes")
Name = "Goblin"
description = "Humanoid monsters that are barely stronger than a clump of bacteria and an overgrown spider, their strength lies in their colonies as they overpower stronger creatures with sheer numbers"
variant_description = "There have been cases where some goblins have acquired a [Class] that puts their raw power on par with a [Bugbear]"

[node name="Orc" type="Button" parent="MonsterTabHolder/ScrollContainer/VBoxContainer" unique_id=1239820845]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("3_k1sou")
text = "Orc
"
script = ExtResource("4_lddes")
Name = "Orc"
description = "A tall and wide humanoid that towers over regular humanoids and much stronger than a regular humanoid too.....just not as smart"
variant_description = "Rare cases have been seen where orcs are born with extreme regenerative capabilities, they are known as [Trolls]"

[node name="Bugbear" type="Button" parent="MonsterTabHolder/ScrollContainer/VBoxContainer" unique_id=1436698465]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("3_k1sou")
text = "BugBear"
script = ExtResource("4_lddes")
Name = "Bugbear"
description = "A strong goblinoid that regularly raids villages, combined with its intellgence its a really annoying pest for humans"
variant_description = "No special cases"

[node name="Ent" type="Button" parent="MonsterTabHolder/ScrollContainer/VBoxContainer" unique_id=2117008589]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("3_k1sou")
text = "Ent"
script = ExtResource("4_lddes")
Name = "Ent"
description = "Trees that have existed for hundreds of years accumulate enough mana to gain sentience, they rarely ever move unless their own life is in danger"
variant_description = "no special cases"

[node name="Shade" type="Button" parent="MonsterTabHolder/ScrollContainer/VBoxContainer" unique_id=692584963]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("3_k1sou")
text = "Shade"
script = ExtResource("4_lddes")
Name = "Shade"
description = "A humanoid taken over by the creatures residing in the [Void],  The host's conciousness is permanently destroyed and replaced with a manic lust for power"
variant_description = "In some cases where the host is extremely capable, shades can become as powerful as a [Dragon]"

[node name="Fiend" type="Button" parent="MonsterTabHolder/ScrollContainer/VBoxContainer" unique_id=1808248130]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("3_k1sou")
text = "Fiend"
script = ExtResource("4_lddes")
Name = "Fiend"
description = "A creature that wields great power, they are creatures that act as agents for the  devils they're contracted with."
variant_description = "No special cases"

[node name="Dragon" type="Button" parent="MonsterTabHolder/ScrollContainer/VBoxContainer" unique_id=1540601891]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("3_k1sou")
text = "Dragon"
script = ExtResource("4_lddes")
Name = "Dragon"
description = "Dragons are born at the top of the hierarchy of all living things and stay there for the rest of their long lives, They look down upon other races and rightfully so with their great intellect and strength and extremely fine tuned mana control theres nothing that can match their strength besides their own kin,The body of a dragon is infused so deeply with magic that even being near a dragon corpse has miraculous effects"
variant_description = "You can't improve something perfect"

